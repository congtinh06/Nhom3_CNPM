@startuml
!theme plain
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor white
  BorderColor #26374A
  FontColor #172536
}
skinparam actor {
  BorderColor #26374A
  FontColor #172536
}
skinparam ArrowColor #52657A
skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
left to right direction

title Use Case — G02: Khám phá và thuyết minh
actor "Khách / người dùng" as User
actor "Thiết bị GPS" as GPS
actor "Camera thiết bị" as Camera
actor "Bản đồ OpenStreetMap" as OSM

rectangle "Echora · Khám phá và thuyết minh" {
  usecase "UC03\nKhám phá điểm tham quan" as UC03
  usecase "UC04\nNghe thuyết minh" as UC04
  usecase "UC05\nTự động thuyết minh theo GPS" as UC05
  usecase "UC06\nTruy cập điểm bằng mã QR" as UC06
}
User --> UC03
OSM --> UC03
User --> UC04
User --> UC05
GPS --> UC05
User --> UC06
Camera --> UC06
@enduml
