@startuml
!theme plain
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor white
  BorderColor #26374A
  FontColor #172536
}
skinparam actor {
  BorderColor #26374A
  FontColor #172536
}
skinparam ArrowColor #52657A
skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
left to right direction

title Use Case — G04: Đơn hàng và quyền truy cập
actor "Người dùng" as User
actor "Quản trị viên" as Admin
actor "Cổng VNPAY / VietQR" as Pay

rectangle "Echora · Đơn hàng và quyền truy cập" {
  usecase "UC10\nQuản lý giỏ hàng" as UC10
  usecase "UC11\nĐặt hàng sản phẩm" as UC11
  usecase "UC12\nMua quyền thuyết minh" as UC12
  usecase "UC13\nThanh toán đơn hàng" as UC13
  usecase "UC14\nQuản lý đơn hàng cá nhân" as UC14
  usecase "UC15\nQuản lý đơn hàng của khách" as UC15
}
User --> UC10
User --> UC11
User --> UC12
User --> UC13
Pay --> UC13
User --> UC14
Admin --> UC15
UC13 ..> UC11 : <<extend>>
[thanh toán trực tuyến]
UC13 ..> UC12 : <<extend>>
[thanh toán trực tuyến]
@enduml
