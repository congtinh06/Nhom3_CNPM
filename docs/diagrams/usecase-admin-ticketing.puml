title HÌNH 3.6. SƠ ĐỒ USE CASE PHÂN HỆ QUẢN TRỊ CMS & QUẦY VÉ

left to right direction

actor "Nhân viên quầy vé\n(Ticket Counter Staff)" as TicketStaff
actor "Quản trị viên hệ thống\n(CMS Administrator)" as Admin
actor "Hạ tầng Redis Cache" as Redis
actor "Hàng đợi RabbitMQ" as RabbitMQ

rectangle "Phân hệ Quản trị CMS & Quầy vé" {
  package "Nghiệp vụ Quầy vé Thực địa" {
    usecase "UC-45: Xác nhận thu tiền mặt và phát hành mã nhận quyền (Claim Code)" as UC45
  }

  package "Nghiệp vụ Quản trị Hệ thống CMS" {
    usecase "UC-25: Đăng nhập quản trị viên CMS" as UC25
    usecase "UC-26: Xem Dashboard tổng quan hệ thống" as UC26
    usecase "UC-27: Xem danh sách điểm di tích (POI)" as UC27
    usecase "UC-28: Thêm mới điểm di tích" as UC28
    usecase "UC-29: Chỉnh sửa thông tin điểm di tích" as UC29
    usecase "UC-30: Quản trị bản dịch đa ngữ của POI" as UC30
    usecase "UC-31: Quản lý và xuất mã QR di sản" as UC31
    usecase "UC-32: Xem nhật ký lỗi dịch thuật và âm thanh" as UC32
    usecase "UC-33: Quản lý danh mục Khu vực (Zone)" as UC33
    usecase "UC-34: Quản lý Lộ trình tham quan (Route)" as UC34
    usecase "UC-35: Sắp xếp thứ tự trạm dừng tour" as UC35
    usecase "UC-36: Quản lý sản phẩm quà lưu niệm" as UC36
    usecase "UC-37: Quản trị bài viết tin tức văn hóa" as UC37
    usecase "UC-38: Quản lý tài khoản người dùng & Phân quyền" as UC38
    usecase "UC-39: Quản lý đơn hàng và xử lý giao hàng" as UC39
    usecase "UC-40: Xem báo cáo thống kê tương tác QR & Audio" as UC40
  }
}

