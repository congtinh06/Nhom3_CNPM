@startuml
!theme plain
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor white
  BorderColor #26374A
  FontColor #172536
}
skinparam actor {
  BorderColor #26374A
  FontColor #172536
}
skinparam ArrowColor #52657A
skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
left to right direction

title Use Case — G05: Quản trị và thống kê
actor "Quản trị viên" as Admin

rectangle "Echora · Quản trị và thống kê" {
  usecase "UC16\nQuản lý tài khoản người dùng" as UC16
  usecase "UC17\nBáo cáo và thống kê" as UC17
}
Admin --> UC16
Admin --> UC17
@enduml
