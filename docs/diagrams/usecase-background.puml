@startuml
!theme plain
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 11
skinparam monochrome true
skinparam shadowing false
skinparam roundCorner 0
skinparam packageStyle rectangle
skinparam handwritten false
skinparam ArrowColor #000000
skinparam ActorBorderColor #000000
skinparam ComponentBorderColor #000000
skinparam DatabaseBorderColor #000000
skinparam InterfaceBorderColor #000000
skinparam ParticipantBorderColor #000000
skinparam SequenceLifeLineBorderColor #000000
skinparam UsecaseBorderColor #000000
skinparam StateBorderColor #000000
skinparam ClassBorderColor #000000

title HÌNH 3.7. SƠ ĐỒ USE CASE PHÂN HỆ DỊCH VỤ NỀN & AI PIPELINE

left to right direction

actor "RabbitMQ Message Broker" as Broker
actor "MyMemory Translation API" as MyMemory
actor "Động cơ Microsoft Edge-TTS" as EdgeTTS
actor "Kho lưu trữ Volume Cục bộ" as Storage

rectangle "Phân hệ Tự động hóa Dịch vụ Nền & AI Pipeline" {
  usecase "UC-41: Tự động dịch thuật nội dung POI đa ngữ\n(AI Translation Pipeline)" as UC41
  usecase "UC-42: Tự động tổng hợp giọng đọc AI\n(Edge-TTS Voice Pipeline)" as UC42
  usecase "UC-43: Thu thập và tổng hợp sự kiện phân tích du lịch\n(Analytics Aggregator)" as UC43

  usecase "Kiểm tra bản dịch thủ công (MANUAL)" as CheckManual
  usecase "Lưu trữ tệp âm thanh MP3" as SaveMP3
  usecase "Phát sự kiện poi.audio.ready" as EmitReady
}

Broker --> UC41 : Tiêu thụ poi.updated
Broker --> UC42 : Kích hoạt sau dịch thuật
Broker --> UC43 : Tiêu thụ sự kiện SCAN / PLAY

UC41 ..> CheckManual : <<include>>
UC41 ..> MyMemory : <<gọi API dịch vi -> en/ja/ko>>
UC42 ..> EdgeTTS : <<gọi CLI sinh MP3>>
UC42 ..> SaveMP3 : <<include>>
SaveMP3 ..> Storage : <<ghi volume /app/storage/audio>>
UC42 ..> EmitReady : <<include>>
EmitReady ..> Broker : <<bắn sự kiện sẵn sàng>>

@enduml
