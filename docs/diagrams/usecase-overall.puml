@startuml
!theme plain
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor white
  BorderColor #26374A
  FontColor #172536
}
skinparam actor {
  BorderColor #26374A
  FontColor #172536
}
skinparam ArrowColor #52657A
skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
left to right direction

title Use Case tổng quan — Echora
actor "Khách" as Guest
actor "Người dùng đã đăng ký" as Member
actor "Quản trị viên" as Admin
actor "Dịch vụ thư điện tử" as Mail
actor "Google OAuth" as Google
actor "Thiết bị GPS" as GPS
actor "Camera thiết bị" as Camera
actor "OpenStreetMap" as OSM
actor "Dịch vụ dịch / giọng nói" as AI
actor "VNPAY / VietQR" as Pay
Member --|> Guest

rectangle "Hệ thống Echora" {
  usecase "G01\nTài khoản và truy cập" as G01
  usecase "G02\nKhám phá và thuyết minh" as G02
  usecase "G03\nQuản lý nội dung du lịch" as G03
  usecase "G04\nĐơn hàng và quyền truy cập" as G04
  usecase "G05\nQuản trị và thống kê" as G05
}
Guest --> G01
Guest --> G02
Guest --> G04
Member --> G01
Member --> G02
Member --> G04
Admin --> G01
Admin --> G03
Admin --> G04
Admin --> G05
Mail --> G01
Google --> G01
GPS --> G02
Camera --> G02
OSM --> G02
AI --> G03
Pay --> G04
note bottom of G05: Chi tiết UC01–UC17 được phân rã trong G01–G05.
@enduml
