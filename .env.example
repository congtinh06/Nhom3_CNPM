# ====================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO HỆ THỐNG SAIGONVOICE (LOCAL FIRST / OFFLINE)
# Sao chép file này thành .env để chạy Docker Compose:
#   cp .env.example .env
# ====================================================================

# 1. SQL Server 2022 Instance (1 Instance duy nhất trên port 1433)
# Yêu cầu SA password tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt
MSSQL_SA_PASSWORD=YourStrong!Passw0rd2026
MSSQL_PID=Developer
MSSQL_MEMORY_LIMIT_MB=2048

# 2. Database Logins & Passwords cho từng Microservice
CONTENT_DB_USER=content_user
CONTENT_DB_PASSWORD=Content!Pass2026

TRANSLATION_DB_USER=translation_user
TRANSLATION_DB_PASSWORD=Translation!Pass2026

ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=Analytics!Pass2026

AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=Auth!Pass2026

# 3. RabbitMQ Message Broker - user riêng cho ứng dụng (KHÔNG dùng guest)
# User chỉ được tạo khi volume rabbitmq-data còn trống: đổi giá trị thì chạy `docker compose down -v`
RABBITMQ_DEFAULT_USER=saigonvoice_app
RABBITMQ_DEFAULT_PASS=ChangeMe_Rabbit!2026

# 4. Xác thực nội bộ và bảo mật Gateway (Defense-in-depth)
INTERNAL_API_KEY=saigonvoice_internal_secret_key_2026
ADMIN_API_KEY=saigonvoice_admin_secret_key_2026
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# 5. Audio Storage (Mặc định: local; tùy chọn khi deploy: supabase)
SAIGONVOICE_STORAGE_TYPE=local
AUDIO_STORAGE_DIR=/app/storage/audio
AUDIO_PUBLIC_BASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=saigonvoice-audio

# 6. Dịch tự động MyMemory (tùy chọn email để tăng hạn mức 50.000 ký tự/ngày)
MYMEMORY_EMAIL=
# Provider dịch: seed (offline, mặc định) hoặc mymemory (cần cấu hình MYMEMORY_EMAIL)
TRANSLATION_PROVIDER=seed
# Thời gian chờ (timeout) cho mỗi ngôn ngữ khi chạy edge-tts tính bằng mili-giây
TTS_TIMEOUT_MS=120000

# 7. Auth Service (Đăng ký / Đăng nhập / JWT) - port 8086
# BẮT BUỘC: secret >= 32 ký tự. Để trống thì auth-service không khởi động được (fail-closed).
# Tạo nhanh: openssl rand -base64 48
JWT_SECRET=
# Cookie refresh dùng Secure=true chỉ chạy được sau HTTPS.
# Môi trường local http://localhost thì để false; production đặt true.
REFRESH_COOKIE_SECURE=false
# Mail (để trống -> không gửi mail thật, token được ghi ra log của auth-service)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=SaigonVoice <no-reply@saigonvoice.local>
# Tài khoản kiểm thử mặc định (dùng cho môi trường demo / kiểm thử đồ án)
SEED_ADMIN_EMAIL=admin@saigonvoice.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_TEST_USER_EMAIL=user@saigonvoice.local
SEED_TEST_USER_PASSWORD=User@123456
