# ====================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO HỆ THỐNG ECHORA (LOCAL FIRST / OFFLINE)
# Sao chép file này thành .env để chạy Docker Compose:
#   cp .env.example .env
#
# !!! CẢNH BÁO BẢO MẬT !!!
# MỌI giá trị mặc định trong file này (mật khẩu DB, RabbitMQ,
# INTERNAL_API_KEY, SEED_*_PASSWORD...) đều là CÔNG KHAI trên git.
# BẮT BUỘC thay bằng giá trị riêng, ngẫu nhiên trong file .env của bạn trước khi
# mở gateway ra Internet (ngrok, deploy...). Không commit file .env.
# Tạo nhanh: openssl rand -base64 32
# ====================================================================

# 1. SQL Server 2022 Instance (1 Instance duy nhất trên port 1433)
# Yêu cầu SA password tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt
MSSQL_SA_PASSWORD=Saigon@123
MSSQL_PID=Developer
MSSQL_MEMORY_LIMIT_MB=2048

# 2. Database Logins & Passwords cho từng Microservice
CONTENT_DB_USER=content_user
CONTENT_DB_PASSWORD=Zpu0fBATzxn6nIriiirxbgNm

TRANSLATION_DB_USER=translation_user
TRANSLATION_DB_PASSWORD=6CWO1eUnX5NcbRkRnBCZYGGb

ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=e2GHyc3TbAHyfpvlLzYCt3fG

AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=Auth!Pass2026

ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=Order!Pass2026

# 3. RabbitMQ Message Broker - user riêng cho ứng dụng (KHÔNG dùng guest)
# User chỉ được tạo khi volume rabbitmq-data còn trống: đổi giá trị thì chạy `docker compose down -v`
RABBITMQ_DEFAULT_USER=echora_app
RABBITMQ_DEFAULT_PASS=SgVoice_Rabbit!2026

# 4. Xác thực nội bộ và bảo mật Gateway (Defense-in-depth)
INTERNAL_API_KEY=Svx2dtOCWzkXL3GsI0JS1UKy7lDqmHcv!9
GATEWAY_PORT=18080
# Port host cho frontend Nginx container (mặc định 8088, ngrok trỏ vào port này)
FRONTEND_HOST_PORT=8088
# Origin được phép gọi API qua CORS (một origin, đã có sẵn http://localhost:5173 và http://127.0.0.1:5173).
FRONTEND_URL=http://localhost:5173
# Danh sách origin bổ sung (phân tách bằng dấu phẩy). Thêm URL tunnel ngrok khi quét QR bằng điện thoại,
# ví dụ: http://localhost:5173,https://xyz.ngrok-free.app,https://nhom3-cnpm.vercel.app
FRONTEND_URLS=http://localhost:5173,https://nhom3-cnpm.vercel.app
VITE_API_BASE_URL=http://localhost:18080

# 5. Audio Storage (Mặc định: local; tùy chọn khi deploy: supabase)
ECHORA_STORAGE_TYPE=local
AUDIO_STORAGE_DIR=/app/storage/audio
AUDIO_PUBLIC_BASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=echora-audio

# 6. Dịch tự động MyMemory (tùy chọn email để tăng hạn mức 50.000 ký tự/ngày)
MYMEMORY_EMAIL=congtinh1932006@gmail.com
# Provider dịch: seed (offline, mặc định) hoặc mymemory (cần cấu hình MYMEMORY_EMAIL)
TRANSLATION_PROVIDER=mymemory
# Thời gian chờ (timeout) cho mỗi ngôn ngữ khi chạy edge-tts tính bằng mili-giây
TTS_TIMEOUT_MS=120000

# 7. Auth Service (Đăng ký / Đăng nhập / JWT) - port 8086
# BẮT BUỘC: secret >= 32 ký tự. Để trống thì auth-service không khởi động được (fail-closed).
JWT_SECRET=YwjOLqV2pk0vAnPwzjHkwVPWHU1LJ3SrzSk80/zMkaY=
# Cookie refresh dùng Secure=true chỉ chạy được sau HTTPS.
# Môi trường local http://localhost thì để false; production đặt true.
REFRESH_COOKIE_SECURE=false
# Mail (để trống -> không gửi mail thật, token được ghi ra log của auth-service)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Echora <no-reply@echora.local>
# Tài khoản kiểm thử mặc định (dùng cho môi trường demo / kiểm thử đồ án)
ADMIN_SEED_EMAIL=quantri@echora.test
ADMIN_SEED_PASSWORD=Admin@123456
SEED_TEST_USER_EMAIL=user@echora.local
SEED_TEST_USER_PASSWORD=User@123456

# Google OAuth Client ID (loại Web) cho đăng nhập bằng Google.
GOOGLE_CLIENT_ID=511593364142-v7edd925d53mjjamjpuu49a25et09ic5.apps.googleusercontent.com

# 8. Order Service & VNPAY Sandbox (port 8087)
VNPAY_TMN_CODE=SQYS1VK9
VNPAY_HASH_SECRET=MMSXWBZDMNKEHMJPNKJJYGFOQFBZVNCI
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:18080/api/orders/vnpay/return
VNPAY_FRONTEND_RESULT_URL=http://localhost:5173/thanh-toan/ket-qua
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_EXPIRE_MINUTES=15
# Phí giao hàng và ngưỡng miễn phí (VND) - phải khớp frontend/src/config/constants.ts
ORDER_SHIPPING_FEE=20000
ORDER_FREE_SHIPPING_THRESHOLD=50000
# Gia goi Premium 3 ngon ngu (EN/JA/KO), don vi VND
ORDER_PREMIUM_PRICE=500000
# Gia mo khoa le mot diem thuyet minh, don vi VND
ORDER_PREMIUM_POI_PRICE=100000
# Cho phép nút "Giả lập đã thanh toán" của VietQR cập nhật trạng thái thật trên server (demo).
PAYMENTS_MOCK_ENABLED=true

# 9. Product Image Upload & Storage (giới hạn 2MB tệp ảnh)
# Thư mục lưu trữ ảnh sản phẩm tải lên bên trong content-service container (được gắn volume product-uploads-data)
PRODUCT_UPLOAD_DIR=/app/uploads/products

