# ====================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO HỆ THỐNG ANTI-PHISHING & BRAND PROTECTION
# Sao chép file này thành .env để chạy Docker Compose hoặc cấu hình local
# ====================================================================

# 1. Google Safe Browsing API (Phase 2)
# Lấy tại Google Cloud Console -> Bật "Safe Browsing API v4" -> Tạo Credentials API Key
GSB_API_KEY=your_google_safe_browsing_api_key_here

# 2. PhishTank API (Tùy chọn, để trống vẫn chạy bình thường)
PHISHTANK_APP_KEY=your_phishtank_api_key_here

# 3. Mail Server (Khuyến nghị dùng Mailtrap.io sandbox để test)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
ADMIN_EMAIL=security-admin@bank-protection.example.com

# 4. Twilio SMS (Tùy chọn cho demo SMS, mặc định tắt)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER_DEMO=+84901234567

# 5. Xác thực nội bộ giữa các service (Defense-in-depth)
INTERNAL_API_KEY=anti_phishing_internal_secret_key_2026

# 6. Database cấu hình mặc định (Docker Compose)
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 7. Frontend cấu hình URL API Gateway
VITE_API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
