{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/prebuild-vercel.mjs && npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(self)"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/client https://*.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.gstatic.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://accounts.google.com https://*.google.com https://*.googleusercontent.com https://*.gstatic.com https://*.openstreetmap.org https://*.tile.openstreetmap.fr https://*.tile.opentopomap.org https://img.vietqr.io; media-src 'self' blob: data:; connect-src 'self' https://accounts.google.com https://*.gstatic.com; frame-src https://accounts.google.com; frame-ancestors 'none';"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://wolf-morse-boasting.ngrok-free.dev/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "ngrok-skip-browser-warning"
          },
          "args": "1"
        }
      ]
    },
    {
      "src": "/img/products/(.*)",
      "dest": "https://wolf-morse-boasting.ngrok-free.dev/img/products/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "ngrok-skip-browser-warning"
          },
          "args": "1"
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(van-hoa|culture|kham-pha|explore|diem-du-lich|diem|nearby|thuyet-minh|gan-toi|am-thuc|thuc-uong|am-thuc-thuc-uong|qua-luu-niem|tin-tuc|huong-dan|lien-he|chinh-sach-quyen-rieng-tu|nang-cap|thanh-toan|don-hang|qr|quet-ma|quet-qr-dang-nhap|nhan-dang-nhap|qr-tai-khoan|dat-lai-mat-khau|xac-thuc-email|tai-khoan|quan-tri|dang-nhap|dang-ky|quen-mat-khau)(/.*)?",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
