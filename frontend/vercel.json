{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://affection-smokiness-watch.ngrok-free.dev/api/$1"
    },
    {
      "source": "/img/products/(.*)",
      "destination": "https://affection-smokiness-watch.ngrok-free.dev/img/products/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
