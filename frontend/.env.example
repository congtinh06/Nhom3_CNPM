# URL của Spring Cloud API Gateway (để rỗng để dùng Vite proxy chuyển tiếp /api sang cổng 18080 lúc dev)
VITE_API_BASE_URL=


# VietQR receiving account (TEST-ONLY). Never hardcode into source; set per environment.
VITE_VIETQR_BANK_ID=VCB
VITE_VIETQR_BANK_NAME=Vietcombank
VITE_VIETQR_ACCOUNT_NO=1234567890
VITE_VIETQR_ACCOUNT_NAME=CONG TY SAI GON FOOD

# Thứ tự ưu tiên nhà cung cấp bản đồ tile raster (phân tách bởi dấu phẩy: osm, hot, opentopo)
VITE_TILE_PROVIDERS=osm,hot,opentopo

# Domain ghi vào nội dung mã QR của điểm du lịch (mặc định lấy theo origin hiện tại khi để trống).
# Ví dụ production: https://nhom3-cnpm.vercel.app
VITE_QR_BASE_URL=

# Google OAuth Client ID (loại Web) cho nút "Đăng nhập bằng Google".
# Phải GIỐNG giá trị GOOGLE_CLIENT_ID của backend (docker-compose / root .env).
# Để trống -> nút Google tự ẩn, chỉ còn đăng nhập bằng mật khẩu.
# BẮT BUỘC đăng ký Authorized JavaScript origins: http://localhost:5173 (dev).
VITE_GOOGLE_CLIENT_ID=
