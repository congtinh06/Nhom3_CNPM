{
  "name": "echora-frontend",
  "description": "Frontend giao diện người dùng cho hệ thống thuyết minh du lịch tự động Echora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "lint": "eslint src",
    "check:spa-routes": "node scripts/check-spa-routes.mjs",
    "prebuild-vercel": "node scripts/prebuild-vercel.mjs",
    "build:vercel": "node scripts/prebuild-vercel.mjs && tsc && vite build"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "axios": "^1.7.7",
    "gsap": "^3.15.1",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "lucide-react": "^0.441.0",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.5",
    "vitest": "^2.1.8"
  }
}
